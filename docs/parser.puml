@startuml gofig-model
title gofig — Configuration Model

left to right direction
skinparam classAttributeIconSize 0
hide empty members

package "gofig" {

  interface Provider {
    +Read() : map[string]any, error
  }

  class Gofig {
    -conf : map[string]any
    +New() : Gofig
    +Load(p : Provider) : error
    +Merge(other : Gofig) : Gofig
    +MergeMap(m : map[string]any) : Gofig
    +Set(parts : []string, value : any) : Gofig
    +Delete(parts ...string) : Gofig
    +Get(parts ...string) : any, bool
    +Raw() : map[string]any
  }

  Gofig ..> Provider : reads in Load()
}

package "provider.keyvalue" {
  class KeyValue {
    -keyValues : map[string]any
    -deepCopy : bool
    +WithDeepCopy(isEnabled : bool) : KeyValue
    +Read() : map[string]any, error
  }
}

' The Parser contract lives in the model docs; no implementation exists yet.
interface Parser <<contract>> {
  +Parse(input : map[string]any) : map[string]any, error
}

Provider <|.. KeyValue : implements

note right of Parser
  <b>A Parser only returns
  the key-value pair</b>
  (map[string]any).
  Defined in the model;
  implementations will be
  standalone modules
  under parser/.
end note

note bottom of Gofig
  <b>Key-value pair manager</b>
  Fluent interface:
  Merge, Set, Delete
  return the Gofig itself.
  Dot paths ("a.b.c")
  address nested maps.
end note

@enduml
