{
  "$schema": "https://opencode.ai/config.json",
  // V1 "permission" rules (V2 "permissions" array requires opencode2).
  // Disable built-in/external skills for this project: hide them from the
  // model's skill list and reject explicit loads (e.g. @report).
  "permission": {
    "skill": {
      // https://github.com/anomalyco/opencode/blob/dev/packages/core/src/plugin/skill/report.md
      "report": "deny",
      // https://github.com/huggingface/skills/blob/main/skills/hf-cli/SKILL.md
      "hf-cli": "deny"
    }
  },
  // Slash command that runs the git-commit skill's workflow (same pattern as
  // the built-in /review: a command delegates, the skill holds the instructions).
  "command": {
    "git-commit": {
      "description": "create a git commit using the git-commit skill",
      "template": "Create a git commit for the current changes. $ARGUMENTS\n\nFollow the git-commit skill for the commit type, the message format, and the project-structure body."
    }
  }
}
